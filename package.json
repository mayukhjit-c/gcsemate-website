{
  "name": "gcsemate-website",
  "version": "1.0.0",
  "description": "GCSE Revision Platform - Free GCSE revision notes, past papers, and study resources",
  "main": "app.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.{js,html,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,html,css,json,md}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:a11y": "npx @axe-core/cli http://localhost:3000 --tags wcag2a,wcag2aa --exit",
    "prepare": "husky install"
  },
  "keywords": [
    "gcse",
    "revision",
    "education",
    "study",
    "uk",
    "aqa",
    "edexcel",
    "ocr"
  ],
  "author": "Mayukhjit Chakraborty",
  "license": "UNLICENSED",
  "devDependencies": {
    "@axe-core/cli": "^4.8.2",
    "@playwright/test": "^1.40.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-jsdoc": "^46.9.0",
    "husky": "^8.0.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.1.0",
    "prettier": "^3.1.0",
    "vite": "^7.2.2"
  },
  "dependencies": {},
  "lint-staged": {
    "*.{js,html,css}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
