{
    "hosting": {
        "public": ".",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**",
            "**/tests/**",
            "**/docs/**",
            "**/*.test.js",
            "**/*.spec.js"
        ],
        "headers": [
            {
                "source": "**/*.css",
                "headers": [
                    {
                        "key": "Content-Type",
                        "value": "text/css; charset=utf-8"
                    },
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=31536000"
                    }
                ]
            },
            {
                "source": "**/*.js",
                "headers": [
                    {
                        "key": "Content-Type",
                        "value": "application/javascript; charset=utf-8"
                    },
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=31536000"
                    }
                ]
            },
            {
                "source": "**/*.html",
                "headers": [
                    {
                        "key": "Content-Type",
                        "value": "text/html; charset=utf-8"
                    },
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=3600"
                    }
                ]
            },
            {
                "source": "sw.js",
                "headers": [
                    {
                        "key": "Content-Type",
                        "value": "application/javascript; charset=utf-8"
                    },
                    {
                        "key": "Cache-Control",
                        "value": "no-cache"
                    }
                ]
            }
        ],
        "cleanUrls": true,
        "trailingSlash": false,
        "rewrites": [
            {
                "source": "/privacypolicy",
                "destination": "/privacypolicy/index.html"
            },
            {
                "source": "/privacypolicy/**",
                "destination": "/privacypolicy/index.html"
            },
            {
                "source": "/termsofservice",
                "destination": "/termsofservice/index.html"
            },
            {
                "source": "/termsofservice/**",
                "destination": "/termsofservice/index.html"
            },
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    }
}
