// firestore.rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers
    function isSignedIn() { return request.auth != null; }
    function userDoc() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }
    function isAdminEmail() {
      return isSignedIn() &&
        request.auth.token.email in ['admin@gcsemate.com', 'support@gcsemate.com'];
    }
    function isAdmin() {
      return isSignedIn() &&
        (
          isAdminEmail() ||
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            (userDoc().role == 'admin' || userDoc().role == 'Admin')
          )
        );
    }
    function isPaid() { return isSignedIn() && userDoc().tier == 'paid'; }
    function hasProtectedUserFieldChanges() {
      return request.resource.data.diff(resource.data).changedKeys().hasAny([
        'role','tier','allowedSubjects','temporaryAccess','forceLogoutAt',
        'subscriptionExpiresAt','subscriptionExpiredAt','subscriptionRenewedAt','lastSubscriptionWarningShown',
        'accountSharingDetected','accountSharingDetectedAt','accountSharingInstances','accountSharingRestoredAt',
        'accountSharingRestoredBy','tierBeforeSharingViolation','concurrentSessions'
      ]);
    }
    function isSafeUserCreate(uid) {
      return isSignedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly([
          'displayName','email','tier','role','starredFiles','allowedSubjects','createdAt',
          'preferences','theme','profilePictureURL','profilePictureUpdatedAt'
        ]) &&
        (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'user') &&
        (!request.resource.data.keys().hasAny(['tier']) || request.resource.data.tier == 'free') &&
        (!request.resource.data.keys().hasAny(['allowedSubjects']) || request.resource.data.allowedSubjects == null);
    }

    // Users collection
    match /users/{uid} {
      // Create own profile at signup
      allow create: if isSafeUserCreate(uid);

      // Read/update own profile (including preferences/storage, profile pictures, and subscription data)
      // Note: Users can update their own profile fields including subscription-related fields
      // Subscription fields are managed by the system and admin, but users can read them
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid && !hasProtectedUserFieldChanges();

      // Admin full control for support (including password reset, account deletion, subscription management)
      allow read, update, delete: if isAdmin();

      // Per-user events subcollection
      match /events/{eventId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }

      // Per-user file index subcollection (metadata only)
      match /userFiles/{fileId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }

      // Per-user notes (e.g., subjectNotes)
      match /notes/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }

      // Per-user flashcards storage
      match /flashcards/{subjectId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }

      // Per-user lesson progress
      match /lessonProgress/{lessonId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid &&
          request.resource.data.keys().hasOnly([
            'lessonId','title','viewedAt','lastOpenedAt','openCount','completedAt','completedBy','updatedAt'
          ]) &&
          request.resource.data.lessonId == lessonId;
      }

      // Per-user grade tracker entries
      match /gradeEntries/{entryId} {
        allow read: if (isSignedIn() && request.auth.uid == uid) || isAdmin();
        allow create, update: if isSignedIn() && request.auth.uid == uid &&
          request.resource.data.keys().hasOnly([
            'userId','subject','subjectKey','grade','assessmentName','examMonth','createdAt','updatedAt'
          ]) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.subject is string && request.resource.data.subject.size() > 0 &&
          request.resource.data.subjectKey is string && request.resource.data.subjectKey.size() > 0 &&
          request.resource.data.assessmentName is string && request.resource.data.assessmentName.size() > 0 &&
          request.resource.data.examMonth is string &&
          request.resource.data.examMonth.matches('^\\d{4}-\\d{2}$') &&
          request.resource.data.grade is number &&
          request.resource.data.grade >= 1 && request.resource.data.grade <= 9;
        allow delete: if (isSignedIn() && request.auth.uid == uid) || isAdmin();
      }
    }

    // Annotations collection - NEW
    match /annotations/{annotationId} {
      // Users can only access their own annotations
      // Annotation ID format: {userId}_{fileId}
      allow read, write: if isSignedIn() &&
        annotationId.matches(request.auth.uid + '_.*');

      // Admins can read all annotations for support
      allow read: if isAdmin();

      // Validation for annotation data
      allow create, update: if isSignedIn() &&
        annotationId.matches(request.auth.uid + '_.*') &&
        request.resource.data.keys().hasOnly(['userId','fileId','canvasData','createdAt','updatedAt']) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.fileId is string &&
        request.resource.data.canvasData is map;
    }

    // Lessons: signed-in users can read, admins manage with validated schema
    match /lessons/{lessonId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasOnly([
          'title','summary','subject','topic','subtopic','category',
          'lessonNumber','sortOrder','publishDate','coverImage','tags','content',
          'interactiveHtml','widgetHtml','links','videoUrls','imageUrls','attachments',
          'buttonLabel','buttonUrl','updatedAt','createdBy','authorName','createdAt'
        ]) &&
        request.resource.data.title is string && request.resource.data.title.size() > 0 &&
        request.resource.data.content is string && request.resource.data.content.size() > 0 &&
        (!request.resource.data.keys().hasAny(['summary']) || request.resource.data.summary == null || request.resource.data.summary is string) &&
        (!request.resource.data.keys().hasAny(['subject']) || request.resource.data.subject == null || request.resource.data.subject is string) &&
        (!request.resource.data.keys().hasAny(['topic']) || request.resource.data.topic == null || request.resource.data.topic is string) &&
        (!request.resource.data.keys().hasAny(['subtopic']) || request.resource.data.subtopic == null || request.resource.data.subtopic is string) &&
        (!request.resource.data.keys().hasAny(['category']) || request.resource.data.category == null || request.resource.data.category is string) &&
        (!request.resource.data.keys().hasAny(['lessonNumber']) || request.resource.data.lessonNumber == null || request.resource.data.lessonNumber is number) &&
        (!request.resource.data.keys().hasAny(['sortOrder']) || request.resource.data.sortOrder == null || request.resource.data.sortOrder is number) &&
        (!request.resource.data.keys().hasAny(['coverImage']) || request.resource.data.coverImage == null || request.resource.data.coverImage is string) &&
        (!request.resource.data.keys().hasAny(['publishDate']) || request.resource.data.publishDate != null) &&
        (!request.resource.data.keys().hasAny(['tags']) || (request.resource.data.tags is list && request.resource.data.tags.size() <= 60)) &&
        (!request.resource.data.keys().hasAny(['links']) || (request.resource.data.links is list && request.resource.data.links.size() <= 100)) &&
        (!request.resource.data.keys().hasAny(['videoUrls']) || (request.resource.data.videoUrls is list && request.resource.data.videoUrls.size() <= 100)) &&
        (!request.resource.data.keys().hasAny(['imageUrls']) || (request.resource.data.imageUrls is list && request.resource.data.imageUrls.size() <= 200)) &&
        (!request.resource.data.keys().hasAny(['attachments']) || (request.resource.data.attachments is list && request.resource.data.attachments.size() <= 100)) &&
        (!request.resource.data.keys().hasAny(['interactiveHtml']) || request.resource.data.interactiveHtml == null || request.resource.data.interactiveHtml is string) &&
        (!request.resource.data.keys().hasAny(['widgetHtml']) || request.resource.data.widgetHtml == null || request.resource.data.widgetHtml is string) &&
        (!request.resource.data.keys().hasAny(['buttonLabel']) || request.resource.data.buttonLabel == null || request.resource.data.buttonLabel is string) &&
        (!request.resource.data.keys().hasAny(['buttonUrl']) || request.resource.data.buttonUrl == null || request.resource.data.buttonUrl is string) &&
        (!request.resource.data.keys().hasAny(['authorName']) || request.resource.data.authorName == null || request.resource.data.authorName is string) &&
        (!request.resource.data.keys().hasAny(['createdBy']) || request.resource.data.createdBy == null || request.resource.data.createdBy is string);
      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && (isPaid() || isAdmin()) &&
          request.resource.data.keys().hasOnly(['text','authorId','authorName','createdAt']) &&
          request.resource.data.text is string && request.resource.data.text.size() > 0 &&
          request.resource.data.authorId == request.auth.uid;
        allow update: if isSignedIn() &&
          (isAdmin() || resource.data.authorId == request.auth.uid) &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['text','updatedAt']) &&
          request.resource.data.text is string && request.resource.data.text.size() > 0;
        allow delete: if isSignedIn() &&
          (isAdmin() || resource.data.authorId == request.auth.uid);
      }
    }

    // Lesson metrics (aggregated views/completions counters maintained by client activity events)
    match /lessonMetrics/{lessonId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() &&
        request.resource.data.keys().hasOnly([
          'lessonId','title','views','completions','lastViewedAt','lastCompletedAt','updatedAt'
        ]) &&
        request.resource.data.lessonId == lessonId &&
        (!request.resource.data.keys().hasAny(['title']) || request.resource.data.title == null || request.resource.data.title is string) &&
        (!request.resource.data.keys().hasAny(['views']) || (request.resource.data.views is number && request.resource.data.views >= 0)) &&
        (!request.resource.data.keys().hasAny(['completions']) || (request.resource.data.completions is number && request.resource.data.completions >= 0));
      allow delete: if isAdmin();
    }

    // Video playlists: readable by signed-in; writable only by admin.
    // Admins are expected to manage playlist metadata (title, playlistId, subject, tags, url).
    match /videoPlaylists/{id} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() &&
        // Only allow a controlled set of fields so clients cannot inject arbitrary data.
        request.resource.data.keys().hasOnly(['title','playlistId','subject','tags','url','createdAt','createdBy','updatedAt','description']) &&
        // Basic type checks
        request.resource.data.title is string &&
        request.resource.data.playlistId is string &&
        (!request.resource.data.keys().hasAny(['subject']) || request.resource.data.subject == null || request.resource.data.subject is string) &&
        (!request.resource.data.keys().hasAny(['url']) || request.resource.data.url == null || request.resource.data.url is string) &&
        (!request.resource.data.keys().hasAny(['description']) || request.resource.data.description == null || request.resource.data.description is string) &&
        // tags must be a list (may be empty); limit size for safety
        (request.resource.data.tags is list) &&
        request.resource.data.tags.size() <= 50;
      allow delete: if isAdmin();
    }

    // Useful links: readable by signed-in; writable by admin
    match /usefulLinks/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Blog posts and comments
    match /blogPosts/{postId} {
      // Posts are authoritatively managed by admins. Clients may read.
      allow read: if isSignedIn();
      allow create, update: if isAdmin() &&
        // Enforce a constrained set of fields for blog posts
        request.resource.data.keys().hasOnly(['title','content','image','tags','subject','createdAt','createdBy','updatedAt','authorId','authorName','imagePublicIds']) &&
        request.resource.data.title is string &&
        request.resource.data.content is string &&
        (!request.resource.data.keys().hasAny(['image']) || request.resource.data.image == null || request.resource.data.image is string) &&
        (!request.resource.data.keys().hasAny(['subject']) || request.resource.data.subject == null || request.resource.data.subject is string) &&
        (!request.resource.data.keys().hasAny(['createdBy']) || request.resource.data.createdBy is string) &&
        (!request.resource.data.keys().hasAny(['authorId']) || request.resource.data.authorId is string) &&
        (!request.resource.data.keys().hasAny(['authorName']) || request.resource.data.authorName is string) &&
        (!request.resource.data.keys().hasAny(['imagePublicIds']) || request.resource.data.imagePublicIds is list) &&
        // tags optional but if present must be a list and limited in size
        (request.resource.data.tags is list) &&
        request.resource.data.tags.size() <= 50;
      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && (isPaid() || isAdmin()) &&
          request.resource.data.keys().hasOnly(['text','authorId','authorName','createdAt']) &&
          request.resource.data.text is string && request.resource.data.text.size() > 0 &&
          request.resource.data.authorId == request.auth.uid;
        allow update: if isSignedIn() &&
          (isAdmin() || resource.data.authorId == request.auth.uid) &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['text','updatedAt']) &&
          request.resource.data.text is string && request.resource.data.text.size() > 0;
        allow delete: if isSignedIn() &&
          (isAdmin() || resource.data.authorId == request.auth.uid);
      }
    }

    // Playlist tags: centralized tag management controlled by admins.
    match /playlistTags/{tagId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasOnly(['name','createdAt','createdBy']) &&
        request.resource.data.name is string && request.resource.data.name.size() > 0;
      allow delete: if isAdmin();
    }

    // Global events
    match /globalEvents/{eventId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Settings (announcement, siteControls, etc.)
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // SUBJECT RESOURCES (read for signed-in; admin writes)
    match /subjectResources/{subjectId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // USER STUDY PLANS
    match /userStudyPlans/{uid} {
      allow read, write: if false; // disallow direct doc ops at root
      match /subjects/{subjectId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // USER PROGRESS
    match /userProgress/{uid} {
      allow read, write: if false;
      match /subjects/{subjectId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // USER EXAM RESULTS
    match /userExamResults/{uid} {
      allow read, write: if false;
      match /subjects/{subjectId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // USER STUDY SESSIONS (analytics - created by the signed-in user, readable by admin)
    match /userStudySessions/{sessionId} {
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly(['userId','subject','startedAt','endedAt','durationMs','durationMinutes']) &&
        request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // USER FILE VIEWS (analytics - created by the signed-in user, readable by admin)
    match /userFileViews/{viewId} {
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly(['userId','subject','fileId','fileName','startedAt','endedAt','durationMs','durationSeconds']) &&
        request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // USER ACTIVITIES (comprehensive activity tracking)
    match /userActivities/{activityId} {
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly(['userId','userEmail','activityType','sessionId','ip','location','userAgent','timestamp','additionalData']) &&
        request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // USER SESSIONS (active session tracking)
    match /userSessions/{sessionId} {
      allow create, update: if isSignedIn() &&
        request.resource.data.keys().hasOnly([
          'userId','sessionId','ip','location','userAgent',
          'isActive','lastSeen','lastActivity','currentSubject',
          'openedFiles','sessionDuration','timestamp','currentFile',
          'pageUrl','screenResolution','timezone'
        ]) &&
        request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // USER DAILY STATS (daily activity statistics)
    match /userDailyStats/{dailyStatsId} {
      allow create, update: if isSignedIn() &&
        request.resource.data.keys().hasOnly(['userId','date','loginCount','totalSessionTime','subjectsStudied','filesAccessed','studyStreak','lastUpdated']) &&
        request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ACCOUNT VIOLATIONS (account sharing detection)
    match /accountViolations/{violationId} {
      allow create: if
        (
          isSignedIn() &&
          request.resource.data.keys().hasOnly(['userId','userEmail','violationType','detectedAt','concurrentSessions','currentIP','currentUserAgent']) &&
          request.resource.data.userId == request.auth.uid
        ) ||
        (
          isAdmin() &&
          request.resource.data.keys().hasOnly(['userId','userEmail','violationType','detectedAt','concurrentSessions','currentIP','currentUserAgent','resolvedBy'])
        );
      allow read: if isAdmin();
    }

    // Admin audit log for tracking admin actions
    match /adminAuditLog/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() &&
        request.resource.data.keys().hasOnly(['adminId','adminEmail','action','targetUserId','targetUserEmail','timestamp','details']) &&
        request.resource.data.adminId == request.auth.uid;
    }

    // System logs (written by client for error reporting; visible to admins)
    match /systemLogs/{logId} {
      allow read: if isAdmin();
      allow create: if (isAdmin() || isSignedIn()) &&
        // Allow any signed-in user to write logs (so client can report errors), but keep read restricted to admins
        request.resource.data.keys().hasOnly(['level','message','details','timestamp','userId','userAgent','url']) &&
        request.resource.data.level is string &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 5000 &&
        (!request.resource.data.keys().hasAny(['userId']) || request.resource.data.userId == request.auth.uid) &&
        request.resource.data.timestamp != null;
      allow update, delete: if isAdmin();
    }

    // Error logs (diagnostic/error tracking; admins read, clients can write)
    match /errorLogs/{logId} {
      allow read: if isAdmin();
      allow create: if (isAdmin() || isSignedIn()) &&
        request.resource.data.keys().hasOnly(['type','message','stack','timestamp','userId','userAgent']) &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 5000 &&
        (!request.resource.data.keys().hasAny(['userId']) || request.resource.data.userId == request.auth.uid) &&
        request.resource.data.timestamp != null;
      allow update, delete: if isAdmin();
    }

    // Backups (created by admin-only tools)
    match /backups/{backupId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Bulk emails queue (queued by admin-only tool in UI)
    match /bulkEmails/{emailId} {
      allow read: if isAdmin();
      allow create: if isAdmin() &&
        request.resource.data.keys().hasOnly(['subject','message','sentBy','sentAt','recipientCount']) &&
        request.resource.data.subject is string &&
        request.resource.data.message is string &&
        request.resource.data.sentBy == request.auth.uid &&
        request.resource.data.recipientCount is int;
      allow update, delete: if isAdmin();
    }

    // Diagnostic tests (used by admin diagnostics panel)
    match /diagnosticTests/{testId} {
      allow read: if isAdmin();
      allow create: if isAdmin() &&
        request.resource.data.keys().hasOnly(['testId','timestamp','userId']);
    }

    // System health (ping/uptime; admin-only by default)
    match /systemHealth/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Cloudinary image deletion queue (for cleanup when blog posts/images are deleted)
    match /cloudinaryDeletions/{deletionId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly(['publicId','cloudName','requestedBy','requestedAt','status']) &&
        request.resource.data.publicId is string &&
        request.resource.data.cloudName is string &&
        request.resource.data.requestedBy == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.requestedAt != null;
      allow update, delete: if isAdmin();
    }

    // AI Tutor rules removed: feature deprecated and endpoint disabled.
    // If you later reintroduce an AI feature, re-add request-tracking and global stats rules with proper validation and admin controls.
  }
}


